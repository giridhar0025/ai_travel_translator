# Copy this file to .env on the Lightsail server and fill in real values.
# Never commit .env.
#
# Generate secrets with:
#   openssl rand -hex 32   # APP_JWT_SECRET
#   openssl rand -hex 24   # POSTGRES_PASSWORD (URL-safe hex)
#
# API_DOMAIN must point at the Lightsail static IP before Caddy can obtain TLS.
# Example: api.203.0.113.10.sslip.io

APP_ENV=production
APP_PORT=8000
APP_JWT_SECRET=replace-with-openssl-rand-hex-32
APP_JWT_EXPIRY_HOURS=720

POSTGRES_DB=translator
POSTGRES_USER=translator
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24

FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

HF_API_TOKEN=
HF_TIMEOUT_SECONDS=90
HF_MODEL_TRANSLATE=meta-llama/Llama-3.3-70B-Instruct
HF_TRANSLATE_PROVIDER=auto
HF_MODEL_STT=openai/whisper-large-v3
HF_STT_PROVIDER=together
REPLICATE_TTS_VERSION=resemble-ai/chatterbox-turbo

LLM_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL_TRANSLATE=openai/gpt-oss-120b
GROQ_MODEL_STT=whisper-large-v3-turbo
STT_PROVIDER=auto

CORS_ALLOWED_ORIGINS=
API_DOMAIN=api.example.com
