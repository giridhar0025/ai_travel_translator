# App
APP_ENV=development
APP_PORT=8123
APP_JWT_SECRET=change-me-with-openssl-rand-hex-32
APP_JWT_EXPIRY_HOURS=720

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5436/translator

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Hugging Face
HF_API_TOKEN=
# Whisper's first request after idle can take 60s+ to cold-start. Bump if you see ReadTimeout.
HF_TIMEOUT_SECONDS=90
HF_MODEL_TRANSLATE=facebook/m2m100_418M
HF_MODEL_STT=openai/whisper-large-v3
# auto prefers Groq Whisper when GROQ_API_KEY is set; set to hf or groq to pin.
STT_PROVIDER=auto
# TTS runs via Replicate (through the HF router). Chatterbox covers en + hi.
# Telugu and Thai have no commercial-safe server-side TTS today; the mobile
# clients fall back to on-device TextToSpeech / AVSpeechSynthesizer.
REPLICATE_TTS_VERSION=resemble-ai/chatterbox-turbo

# CORS — comma-separated list
CORS_ALLOWED_ORIGINS=

# Groq (translation LLM, free tier). When GROQ_API_KEY is set, LLM_PROVIDER=auto
# uses Groq instead of the HF router (which 402s once credits run out).
LLM_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL_TRANSLATE=openai/gpt-oss-120b
GROQ_MODEL_STT=whisper-large-v3-turbo
